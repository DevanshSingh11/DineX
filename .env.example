# python -m dinex init creates .env with a random signing key.
DINEX_SECRET=
DINEX_DATABASE=data/universal.sqlite3
DINEX_PUBLIC_URL=http://127.0.0.1:8000
DINEX_SECURE_COOKIES=false
# Optional HTTPS endpoint implementing the chat/completions request format
DINEX_AI_URL=
DINEX_AI_MODEL=
DINEX_AI_KEY=
# Optional server-side Gemini key. Set-Gemini-Key.bat prompts for this privately.
GEMINI_API_KEY=
DINEX_GEMINI_MODEL=gemini-flash-latest
